# =============================================================================
# ZIMRA POS Platform — Environment Variables Reference
# Copy this file to .env and fill in your values.
# NEVER commit .env to git. This file (.env.example) is safe to commit.
# =============================================================================

# ─── DATABASE (Supabase) ──────────────────────────────────────────────────────
#
# TWO connection strings are required for Prisma + Supabase:
#
# 1. DATABASE_URL  → Transaction Pooler (port 6543) — used by Prisma Client
#    Path in Supabase: Project → Connect → Transaction Pooler
#    Note: ?pgbouncer=true disables prepared statements (required for pooling)
#
DATABASE_URL="postgresql://postgres.azuxamkixoezsjejaklf:%40delroy%230522@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true?connect_timeout=30"

# 2. DIRECT_URL → Direct connection (port 5432) — used by prisma migrate deploy
#    Path in Supabase: Project → Connect → Direct Connection
#
DIRECT_URL="postgresql://postgres.azuxamkixoezsjejaklf:%40delroy%230522@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?connect_timeout=30"

# Supabase S3 Configuration
S3_ENDPOINT="https://azuxamkixoezsjejaklf.supabase.co/storage/v1/s3"
S3_REGION="eu-central-1" # Supabase uses 'global' or 'us-east-1'
S3_ACCESS_KEY_ID="5c7f7f7c0d16da024399c5967f0ef997"
S3_SECRET_ACCESS_KEY="88f29d64db455f27919bf6e65b9eac410c2c11fc53661c4079ab71ac9ed8f842"
S3_BUCKET_NAME="fiscali-backups"

# ─── APPLICATION ──────────────────────────────────────────────────────────────

NODE_ENV=development           # "development" | "production"
PORT=3003                      # API server port
APP_BASE_URL=http://localhost:3000   # Your Vercel URL in production

# ─── AUTH / JWT ───────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

ration

# ─── DEVICE KEY ENCRYPTION ────────────────────────────────────────────────────
# Used to AES-256-GCM encrypt device private keys at rest in PostgreSQL.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRITICAL: If you lose this, you cannot decrypt stored private keys.
#           Rotation requires re-registering all devices with ZIMRA.

DEVICE_KEY_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
DEVICE_KEY_SALT=REPLACE_WITH_FIXED_32_CHAR_APP_SALT

# ─── ZIMRA FDMS ───────────────────────────────────────────────────────────────
# "development" → https://fdmsapidev.zimra.co.zw (sandbox)
# "production"  → https://fdmsapi.zimra.co.zw     (live)

ZIMRA_ENVIRONMENT=development
ZIMRA_TIMEOUT_MS=30000

# ─── PAYNOW ───────────────────────────────────────────────────────────────────
# Get from: https://www.paynow.co.zw → Merchant Portal → Integration Settings

PAYNOW_INTEGRATION_ID=REPLACE_WITH_PAYNOW_INTEGRATION_ID
PAYNOW_INTEGRATION_KEY=REPLACE_WITH_PAYNOW_INTEGRATION_KEY

# ─── ECOCASH (Econet Developer Portal) ────────────────────────────────────────

ECOCASH_API_URL=https://api.econet.co.zw/apis/ecocash/v1/transactions
ECOCASH_MERCHANT_CODE=REPLACE_WITH_MERCHANT_CODE
ECOCASH_MERCHANT_PIN=REPLACE_WITH_MERCHANT_PIN
ECOCASH_MERCHANT_NUMBER=REPLACE_WITH_MERCHANT_NUMBER
ECOCASH_API_TOKEN=REPLACE_WITH_API_TOKEN
ECOCASH_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_HMAC_SECRET

# ─── INNBUCKS ─────────────────────────────────────────────────────────────────

INNBUCKS_API_URL=https://api.innbucks.co.zw/v1/payments/initiate
INNBUCKS_MERCHANT_ID=REPLACE_WITH_MERCHANT_ID
INNBUCKS_API_KEY=REPLACE_WITH_API_KEY
INNBUCKS_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_HMAC_SECRET

# ─── ZIPIT ────────────────────────────────────────────────────────────────────

ZIPIT_BENEFICIARY_ACCOUNT=REPLACE_WITH_BANK_ACCOUNT_NUMBER
ZIPIT_BENEFICIARY_BANK=CBZ
ZIPIT_BENEFICIARY_NAME=REPLACE_WITH_REGISTERED_BUSINESS_NAME
ZIPIT_WEBHOOK_API_KEY=REPLACE_WITH_ZIPIT_WEBHOOK_KEY

# ─── BACKGROUND WORKER ────────────────────────────────────────────────────────

WORKER_POLL_INTERVAL_MS=10000
WORKER_MAX_CONCURRENT=3

# ─── NEXT.JS (frontend — Vercel) ──────────────────────────────────────────────
# NEXT_PUBLIC_ prefix makes these available in the browser bundle.
# Only put non-sensitive config here.

NEXT_PUBLIC_API_URL=http://localhost:3003
