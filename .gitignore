# =============================================================================
# .gitignore — ZIMRA POS Platform & Backend API
# =============================================================================

# ── Dependency Folders ────────────────────────────────────────────────────────
node_modules/
jspm_packages/
web_modules/

# ── Environment & Secret Files (CRITICAL) ────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# ── Build & Compilation Outputs ──────────────────────────────────────────────
dist/
build/
out/
*.tsbuildinfo

# ── Prisma Local Artifacts ───────────────────────────────────────────────────
# Ignore generated Prisma Client files if generated outside node_modules
# (Keep prisma/migrations/ committed to git!)
prisma/sqlite.db
prisma/sqlite.db-journal

# ── Logs & Debugging ─────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Local Backup / Dump Files ────────────────────────────────────────────────
# Ignore dumps generated by your backup-db.sh script
*.sql
*.sql.gz
backups/

# ── System & IDE Files ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# VS Code & JetBrains IDE settings
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Temporary / Cache Folders ────────────────────────────────────────────────
.cache/
.npm/
.eslintcache
.parcel-cache/
.tmp/